# Caddy obtains and renews the HTTPS certificate for CRM_DOMAIN automatically (Let's Encrypt).
# The DNS A/AAAA record for the domain must point at this server, and ports 80 and 443 must be open.
{$CRM_DOMAIN} {
	encode zstd gzip
	reverse_proxy web:8000
	request_body {
		max_size 5MB
	}
	log {
		output stdout
		format console
	}
}
