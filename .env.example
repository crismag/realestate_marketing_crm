# Copy to .env (never commit .env) or export these variables before running.
CRM_ENV=development            # development | test | production
CRM_DEBUG=1                    # never 1 in production
# Required in production; in development a random key is generated in var/secret_key
CRM_SECRET_KEY=
CRM_ALLOWED_HOSTS=localhost,127.0.0.1
CRM_CSRF_TRUSTED_ORIGINS=
CRM_SECURE_COOKIES=0           # set 1 when served over HTTPS
CRM_SSL_REDIRECT=0
CRM_HSTS_SECONDS=0
CRM_BEHIND_TLS_PROXY=
CRM_VAR_DIR=./var              # database, backups, sandbox mail, secret key
CRM_DB_PATH=./var/crm.sqlite3
CRM_BACKUP_DIR=./var/backups
CRM_EMAIL_TRANSPORT=sandbox    # only 'sandbox' is implemented; nothing is sent
CRM_SESSION_HOURS=12
CRM_LOGIN_MAX_FAILURES=5
CRM_LOGIN_LOCK_MINUTES=15
CRM_WORKER_POLL_SECONDS=5
CRM_WORKER_LEASE_SECONDS=120
CRM_LOG_LEVEL=INFO
# Website/form intake API (POST /api/intake/inquiries). Disabled while empty.
CRM_INTAKE_TOKEN=
CRM_INTAKE_POOL=               # pool name; optional when exactly one active pool exists
# Staff email (password reset links to employees). Without a host, messages are written to var/staff_mail/.
CRM_STAFF_SMTP_HOST=
CRM_STAFF_SMTP_PORT=587
CRM_STAFF_SMTP_USER=
CRM_STAFF_SMTP_PASSWORD=
CRM_STAFF_SMTP_TLS=1
CRM_STAFF_FROM_EMAIL=
